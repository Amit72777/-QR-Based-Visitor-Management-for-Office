# ── File Uploads ──────────────────────────────────────────────────────
# Where visitor photos are saved on disk (relative to backend/)
UPLOAD_DIR=uploads/photos

# ── Debug ─────────────────────────────────────────────────────────────
DEBUG=True



# Silence the html5-qrcode source map warnings — they are harmless
# but noisy. This stops webpack from trying to find the missing .ts files.
# GENERATE_SOURCEMAP=false
