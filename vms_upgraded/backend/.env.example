# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/qr_visitor_db

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── QR Code ───────────────────────────────────────────────────────────
# How many hours before a QR code expires (default: 24)
QR_EXPIRY_HOURS=24

# ── First Admin Seed ──────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@company.com
FIRST_ADMIN_PASSWORD=Admin@1234
FIRST_ADMIN_NAME=System Administrator

# ── SMTP Email (Gmail) ────────────────────────────────────────────────
# Set SMTP_ENABLED=True to start sending QR codes by email.
# For Gmail: create an "App Password" at myaccount.google.com/apppasswords
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-email@gmail.com

# ── File Uploads ──────────────────────────────────────────────────────
# Where visitor photos are saved on disk (relative to backend/)
UPLOAD_DIR=uploads/photos

# ── Debug ─────────────────────────────────────────────────────────────
DEBUG=True
